# Copy this file to .env and fill in your own key. Never commit the real .env.
OPENAI_API_KEY=sk-your-key-here

# Cheap + fast model for most nodes (JD parsing, gap analysis, drafting)
OPENAI_CHAT_MODEL=gpt-4o-mini

# The critic node's judgment call ("is this actually grounded / actually honest?") is
# harder than plain extraction. gpt-4o-mini can be over-strict here; try gpt-4o if the
# critic keeps rejecting drafts that look fine to you.
OPENAI_CRITIC_MODEL=gpt-4o-mini

OPENAI_EMBED_MODEL=text-embedding-3-small

# Where the local vector store persists on disk
CHROMA_DB_DIR=./chroma_db

# Phase 7: shared access code protecting the deployed site from anonymous use of your
# OpenAI quota. Leave blank for local dev (no gate at all). Set this to a real secret
# before deploying publicly -- the frontend's login screen sends it as X-Access-Code.
ACCESS_CODE=

# Where the "history" (past gap-analysis/draft runs) SQLite database persists on disk
HISTORY_DB_PATH=./history.db
